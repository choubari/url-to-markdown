{
	"name": "url-to-markdown",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-18",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"not_found_handling": "none",
	},
	"rules": [{ "type": "Text", "globs": ["**/*.html"] }],
	"observability": {
		"enabled": true,
	},
	"vars": {
		"BASE_URL": "https://md.choubari.com",
		"POSTHOG_PUBLIC_KEY": "",
		"POSTHOG_HOST": "https://eu.i.posthog.com",
	},
	// Rate limiting: create a namespace in CF Dashboard → Workers & Pages → Rate Limiting
	// then replace the namespace_id below with your own
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 5, "period": 60 },
			},
		],
	},
}
