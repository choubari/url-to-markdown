{
	"name": "url-to-markdown",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-18",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"not_found_handling": "none"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/*.html"] }
	],
	"vars": {
		"BASE_URL": "",
		"POSTHOG_PUBLIC_KEY": "",
		"POSTHOG_HOST": ""
	}
}
